//
// This file defines the AltairXArch-specific builtin function database.
// Users of this file must define the BUILTIN macro to make use of this
// information.
//
//===----------------------------------------------------------------------===//

#if defined(BUILTIN) && !defined(TARGET_BUILTIN)
#   define TARGET_BUILTIN(ID, TYPE, ATTRS, FEATURE) BUILTIN(ID, TYPE, ATTRS)
#endif

BUILTIN(__builtin_altairx_syscall0, "LiLi", "n")
BUILTIN(__builtin_altairx_syscall1, "LiLiLi", "n")
BUILTIN(__builtin_altairx_syscall2, "LiLiLiLi", "n")
BUILTIN(__builtin_altairx_syscall3, "LiLiLiLiLi", "n")
BUILTIN(__builtin_altairx_syscall4, "LiLiLiLiLiLi", "n")
BUILTIN(__builtin_altairx_syscall5, "LiLiLiLiLiLiLi", "n")
BUILTIN(__builtin_altairx_syscall6, "LiLiLiLiLiLiLiLi", "n")
BUILTIN(__builtin_altairx_syscall7, "LiLiLiLiLiLiLiLiLi", "n")

#undef BUILTIN
#undef TARGET_BUILTIN
